# Same-origin production service and Vite development proxy:
VITE_API_BASE=/api
# For separate hosting, use https://YOUR-BACKEND.onrender.com/api instead.
# Every VITE_* variable is PUBLIC. Never put provider/API credentials here.

# Optional server-only Vite dev proxy target. Use this when the backend is hosted
# instead of running on http://127.0.0.1:5001. Do not append /api.
# THREADLABS_DEV_API_TARGET=https://threadlabs-current.onrender.com
# Copy the target setting into ignored .env.development.local, then restart Vite.
# This connects to REAL accounts/data on that service; it does not enable demo mode.
