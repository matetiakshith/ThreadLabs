# Copy to .env. Enter credentials only in that ignored, server-side file.
PORT=5001
NODE_ENV=development
HOST=127.0.0.1
SERVE_FRONTEND=false
# Production: NODE_ENV=production, HOST=0.0.0.0, SERVE_FRONTEND=true.
# Render supplies PORT, RENDER and RENDER_EXTERNAL_URL automatically.
# Use the mounted persistent disk path in production; never client/public.
DATA_DIR=
# Required for real accounts and durable customer/artisan commissions.
# Use a provider-issued PostgreSQL URL with validated TLS for external hosts.
DATABASE_URL=
# Server-only operator access to legacy order/catalog APIs (minimum 32 chars).
# This does not implement customer authentication. Never put it in VITE_*.
LEGACY_API_TOKEN=
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# In production use only actual HTTPS custom/frontend origins. Render's own
# RENDER_EXTERNAL_URL is added automatically for a same-origin service.
HF_TOKEN=

# Hosted Inference Providers (no private endpoint required).
HF_IMAGE_MODE=providers
HF_IMAGE_PROVIDER=fal-ai
HF_IMAGE_MODEL=Qwen/Qwen-Image
HF_IMAGE_EDIT_PROVIDER=fal-ai
HF_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit
# Set HF_IMAGE_EDIT_MODEL=none to explicitly disable image conditioning.
# fal-ai accepts references inline; ThreadLabs never uploads them to a public bucket.

# Future dedicated GPU deployment of the existing LoKR adapter:
# HF_IMAGE_MODE=dedicated
# HF_IMAGE_MODEL=houseofboern/realism-nano-banana-qwen-image-2.1-lokr
# HF_IMAGE_ENDPOINT=https://YOUR-DEPLOYMENT.endpoints.huggingface.cloud
# Enable only capabilities that your deployed handler actually implements.
# HF_IMAGE_SUPPORTS_TEXT=false
# HF_IMAGE_SUPPORTS_REFERENCE=true
# HF_IMAGE_SUPPORTS_SEED=false
# This adapter is an image-editing realism adapter, not a hosted base generator.
# A compatible base model/runtime and license review are required for deployment.

# Retained names for unrelated integrations; image generation does not use them.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Phase 2: review 002_phase2.sql and back up production before applying once.
PHASE2_MIGRATE=false
# Private Supabase Storage project URL, server secret key (sb_secret_...) and PRIVATE bucket.
# Legacy service_role JWT keys remain supported.
# Never use a public bucket or place the key in a VITE_* variable.
OBJECT_STORAGE_URL=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_BUCKET=threadlabs-private
# Separate server-side chat configuration. The image provider is unaffected.
ASSISTANT_ENDPOINT=https://router.huggingface.co/v1/chat/completions
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_MS=45000
ASSISTANT_MAX_TOKENS=1500
ASSISTANT_RATE_LIMIT=12
# Optional verified Resend sending domain for one-use 30-minute password resets.
RESEND_API_KEY=
RESET_EMAIL_FROM=
APP_URL=
